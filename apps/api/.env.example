# Copy this to .env and fill in all values before deploying
# Railway: set these as environment variables in the Railway dashboard

# App
NODE_ENV=production
PORT=4000
WEB_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dating_app"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Feature Flags
ALLOW_NSFW_CONTENT=true

# Twilio (phone OTP)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="CRUSH <noreply@crush.app>"

# Cloudinary (photo storage + AI moderation)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Azure Content Safety (AI-based CSAM + violence detection)
AZURE_CONTENT_SAFETY_ENDPOINT=""
AZURE_CONTENT_SAFETY_KEY=""

# Microsoft PhotoDNA (hash-based CSAM detection against NCMEC database — apply at aka.ms/photodna)
PHOTODNA_API_KEY=""

# Google Vision SafeSearch (optional secondary AI layer)
GOOGLE_VISION_API_KEY=""

# Stripe (billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Separate endpoint secret for Stripe Identity verification webhooks
STRIPE_IDENTITY_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=""
STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=""

# Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:support@crush.app"
