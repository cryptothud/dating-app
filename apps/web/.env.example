NEXT_PUBLIC_API_URL=       # leave blank in dev — Next.js proxy handles it
NEXT_PUBLIC_SOCKET_URL=    # leave blank in dev — Next.js proxy handles it; set to Railway URL in prod
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical site URL, used for OpenGraph and canonical tags in the root layout
NEXT_PUBLIC_WEB_URL=

# Production (fill these in for Vercel deployment)
# NEXT_PUBLIC_API_URL=https://your-api.railway.app/api
# NEXT_PUBLIC_SOCKET_URL=https://your-api.railway.app
# NEXT_PUBLIC_WEB_URL=https://your-domain.com
