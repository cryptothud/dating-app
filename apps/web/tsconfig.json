{
  "extends": "@dating-app/config/typescript",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@dating-app/types": ["../../packages/types/src/index.ts"],
      "@dating-app/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowArbitraryExtensions": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
